---
import ProfileSectionLayout from '../layouts/ProfileSectionLayout.astro';
---

<ProfileSectionLayout
	title="Courier Survey Descriptive Statistics"
	description="Descriptive statistics from the food delivery courier survey project."
	currentPath="/projects"
	pageTitle="Courier Survey Descriptive Statistics"
	pageIntro="Food delivery courier survey project snapshot."
>
	<section class="content-card">
		<figure class="summary-figure">
			<img
				src="/project-courier-survey-summary.png"
				alt="Descriptive statistics for the food delivery courier survey project"
			/>
		</figure>
	</section>
</ProfileSectionLayout>

<style>
	.summary-figure {
		margin: 0;
	}

	.summary-figure img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.65rem;
	}
</style>