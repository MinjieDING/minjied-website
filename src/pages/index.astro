---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { profile, siteMeta } from '../data/siteData';
---

<Layout
	title="Minjie Ding | Home"
	description={siteMeta.description}
>
	<SiteHeader currentPath="/" />
	<div class="home-shell">
		<section class="home-hero">
			<div class="home-portrait">
				<img src={profile.avatarSrc} alt={profile.avatarAlt} />
			</div>
			<div class="home-copy">
				<p class="home-kicker">About</p>
				<p class="home-lead">
					I am Minjie Ding, a researcher working on macroeconomics and housing markets,
					drawing on tools from statistics and computer science.
				</p>
				<p class="home-meta">Email: {profile.email}</p>
			</div>
		</section>
	</div>
</Layout>

<style>
	:global(body) {
		font-family: 'Avenir Next', 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', sans-serif;
		color: #2d352c;
		background:
			radial-gradient(circle at top left, rgba(245, 240, 231, 0.88), transparent 32%),
			linear-gradient(180deg, #f5f0e7 0%, #ffffff 26%);
	}

	:global(a) {
		color: #7d9d57;
		text-decoration: none;
	}

	:global(a:hover) {
		color: #5f7f3e;
	}

	.home-shell {
		max-width: 1180px;
		margin: 0 auto;
		padding: 2rem 1.2rem 3.5rem;
	}

	.home-hero {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.1rem;
		justify-items: center;
		align-items: start;
		padding: 1.4rem 1.5rem;
		border-radius: 1.4rem;
		background: rgba(255, 255, 255, 0.86);
		border: 1px solid #dfe5db;
		box-shadow: 0 22px 44px rgba(49, 66, 52, 0.08);
	}

	.home-portrait {
		display: flex;
		justify-content: center;
		width: 100%;
	}

	.home-portrait img {
		width: 170px;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 50%;
		border: 7px solid #f4f4f1;
		box-shadow: 0 10px 22px rgba(49, 66, 52, 0.08);
	}

	.home-kicker {
		margin: 0;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		font-size: 0.76rem;
		color: #9a615d;
	}

	.home-copy {
		width: 100%;
		max-width: 52rem;
	}

	.home-copy h1 {
		font-family: 'Iowan Old Style', 'Palatino Linotype', 'Book Antiqua', serif;
	}

	.home-lead,
	.home-meta {
		line-height: 1.8;
		color: #435043;
	}

	.home-lead {
		max-width: none;
		margin: 0;
		font-size: 1.02rem;
	}

	.home-meta {
		margin: 0.95rem 0 0;
	}

	@media (max-width: 900px) {
		.home-portrait img {
			width: 150px;
		}
	}

	@media (max-width: 640px) {
		.home-shell {
			padding-left: 0.9rem;
			padding-right: 0.9rem;
		}

		.home-hero {
			padding: 1.15rem;
		}
	}
</style>
