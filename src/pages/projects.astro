---
import ProfileSectionLayout from '../layouts/ProfileSectionLayout.astro';
import { projectAreas } from '../data/siteData';
---

<ProfileSectionLayout
	title="Minjie Ding | Projects"
	description="Selected projects, data pipelines, and research infrastructure by Minjie Ding."
	currentPath="/projects"
	pageTitle="Projects"
	pageIntro="These projects support the research workflow, from data collection to repeatable analysis and writing systems."
>
	<div class="content-stack">
		{projectAreas.map((area) => (
			<article class:list={["content-card", "project-card", !area.imageSrc && 'project-card-no-media']}>
				{area.imageSrc && (
					<div class="project-media">
						<img src={area.imageSrc} alt={area.imageAlt ?? ''} loading="lazy" />
					</div>
				)}
				<div class="project-copy">
					<p class="project-tag">{area.tag}</p>
					<h2>{area.title}</h2>
					<p>{area.description}</p>
					<ul>
						{area.items.map((item) => <li>{item}</li>)}
					</ul>
					{area.links && area.links.length > 0 && (
						<div class="project-links">
							{area.links.map((link) => (
								<a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noreferrer' : undefined}>
									{link.label}
								</a>
							))}
						</div>
					)}
				</div>
			</article>
		))}
	</div>
</ProfileSectionLayout>

<style>
	.project-card {
		display: grid;
		grid-template-columns: minmax(180px, 240px) minmax(0, 1fr);
		gap: 1.25rem;
	}

	.project-card-no-media {
		grid-template-columns: 1fr;
	}

	.project-media {
		min-height: 170px;
		border-radius: 0.85rem;
		background:
			linear-gradient(145deg, rgba(125, 157, 87, 0.22), rgba(165, 90, 87, 0.12)),
			#eef1e9;
		border: 1px solid rgba(125, 157, 87, 0.18);
		overflow: hidden;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.project-media img {
		max-width: 100%;
		max-height: 100%;
		width: 100%;
		height: auto;
		object-fit: contain;
	}

	.project-tag {
		margin: 0 0 0.35rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		font-size: 0.74rem;
		color: #9a615d;
	}

	.project-copy {
		display: grid;
		align-content: start;
	}

	.project-card-no-media .project-copy {
		max-width: none;
	}

	.project-links {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-top: 1rem;
	}

	.project-links a {
		padding: 0.72rem 1rem;
		border-radius: 999px;
		border: 1px solid rgba(84, 104, 77, 0.24);
		background: #fbfbf7;
	}

	@media (max-width: 900px) {
		.project-card {
			grid-template-columns: 1fr;
		}
	}
</style>